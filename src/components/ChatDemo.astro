---
// Conversación simulada del agente: burbujas que aparecen en secuencia al entrar en viewport.
// Sin layout shift: todas las burbujas reservan su espacio y solo animan opacidad/transform.
interface Msg {
  from: 'user' | 'agent';
  text?: string;
  voice?: boolean;
  duration?: string;
}

interface Props {
  header: string;
  status: string;
  messages: Msg[];
}

const { header, status, messages } = Astro.props;

// Timeline: usuario aparece rápido; el agente «escribe» ~0.9s antes de mostrar el texto
const DELAYS = [0.2, 1.1, 3.0, 3.9];
const TYPE_TIME = 0.9;

const transcript = messages
  .map((m) => `${m.from}: ${m.voice ? `(${m.duration} voice note)` : m.text}`)
  .join(' · ');
---

<div class="chat-demo border-beam" data-reveal role="img" aria-label={`${header} — ${transcript}`}>
  <div class="cd-bar" aria-hidden="true">
    <span class="cd-dot r"></span>
    <span class="cd-dot y"></span>
    <span class="cd-dot g"></span>
    <span class="cd-title">{header}</span>
    <span class="cd-status"><span class="cd-live"></span>{status}</span>
  </div>
  <div class="cd-body" aria-hidden="true">
    {messages.map((m, i) => (
      <div class={`cd-msg ${m.from}`} style={`--d:${DELAYS[i] ?? i * 1.2}s; --t:${TYPE_TIME}s`}>
        {m.voice ? (
          <span class="cd-voice">
            <svg viewBox="0 0 24 24" fill="none" class="cd-play"><path d="M8 5.5v13l11-6.5-11-6.5Z" fill="currentColor" /></svg>
            <span class="cd-wave">
              {Array.from({ length: 16 }).map(() => (
                <i></i>
              ))}
            </span>
            <span class="cd-dur">{m.duration}</span>
          </span>
        ) : (
          <span class="cd-text">{m.text}</span>
        )}
        {m.from === 'agent' && !m.voice && (
          <span class="cd-dots"><i></i><i></i><i></i></span>
        )}
      </div>
    ))}
  </div>
</div>

<style>
  .chat-demo {
    width: min(460px, 100%);
    margin-inline: auto;
    background: #0b0f14;
    border: 1px solid rgba(0, 255, 156, 0.18);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.4), 0 26px 60px rgba(0, 0, 0, 0.45), 0 0 50px rgba(0, 255, 156, 0.07);
  }

  .cd-bar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.62rem 0.85rem;
    background: rgba(255, 255, 255, 0.03);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }
  .cd-dot { width: 11px; height: 11px; border-radius: 50%; }
  .cd-dot.r { background: #ff5f56; }
  .cd-dot.y { background: #ffbd2e; }
  .cd-dot.g { background: #27c93f; }
  .cd-title {
    margin-left: 0.45rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    color: #8a97a5;
  }
  .cd-status {
    margin-left: auto;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: #00ff9c;
  }
  .cd-live {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #00ff9c;
    box-shadow: 0 0 8px #00ff9c;
    animation: cdLive 1.6s ease-in-out infinite;
  }
  @keyframes cdLive { 50% { opacity: 0.35; } }

  .cd-body {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    padding: 1.1rem 0.95rem 1.25rem;
    font-family: var(--font-body);
    font-size: 0.86rem;
    line-height: 1.5;
  }

  .cd-msg {
    position: relative;
    max-width: 84%;
    padding: 0.62rem 0.8rem;
    border-radius: 14px;
    opacity: 0;
    transform: translateY(10px) scale(0.97);
  }
  .cd-msg.user {
    align-self: flex-end;
    background: rgba(0, 255, 156, 0.14);
    border: 1px solid rgba(0, 255, 156, 0.28);
    color: #d9ffef;
    border-bottom-right-radius: 4px;
  }
  .cd-msg.agent {
    align-self: flex-start;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.09);
    color: #cdd9e3;
    border-bottom-left-radius: 4px;
  }

  /* La secuencia arranca cuando el reveal marca la ventana como visible */
  .chat-demo.is-visible .cd-msg {
    animation: cdPop 0.45s cubic-bezier(0.2, 0.9, 0.3, 1.15) forwards;
    animation-delay: var(--d);
  }

  /* El agente «escribe»: puntos visibles primero, el texto entra después */
  .cd-msg.agent .cd-text {
    opacity: 0;
  }
  .chat-demo.is-visible .cd-msg.agent .cd-text {
    animation: cdShow 0.3s ease forwards;
    animation-delay: calc(var(--d) + var(--t));
  }
  .cd-dots {
    position: absolute;
    left: 0.85rem;
    top: 50%;
    transform: translateY(-50%);
    display: inline-flex;
    gap: 4px;
    opacity: 0;
  }
  .chat-demo.is-visible .cd-dots {
    animation: cdDotsLife calc(var(--t) + 0.15s) ease forwards;
    animation-delay: var(--d);
  }
  .cd-dots i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8a97a5;
    animation: cdBounce 0.9s ease-in-out infinite;
  }
  .cd-dots i:nth-child(2) { animation-delay: 0.15s; }
  .cd-dots i:nth-child(3) { animation-delay: 0.3s; }

  /* Nota de voz */
  .cd-voice { display: inline-flex; align-items: center; gap: 0.55rem; }
  .cd-play { width: 16px; height: 16px; color: #00ff9c; flex: 0 0 auto; }
  .cd-wave { display: inline-flex; align-items: center; gap: 2px; height: 22px; }
  .cd-wave i {
    width: 3px;
    border-radius: 2px;
    background: rgba(0, 255, 156, 0.75);
  }
  .cd-wave i:nth-child(4n + 1) { height: 30%; }
  .cd-wave i:nth-child(4n + 2) { height: 75%; }
  .cd-wave i:nth-child(4n + 3) { height: 50%; }
  .cd-wave i:nth-child(4n) { height: 90%; }
  .cd-dur { font-family: var(--font-mono); font-size: 0.7rem; color: #8a97a5; }

  @keyframes cdPop { to { opacity: 1; transform: none; } }
  @keyframes cdShow { to { opacity: 1; } }
  @keyframes cdDotsLife {
    0% { opacity: 0; }
    12% { opacity: 1; }
    82% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes cdBounce { 0%, 100% { transform: translateY(1px); } 50% { transform: translateY(-3px); } }

  @media (prefers-reduced-motion: reduce) {
    .cd-msg { opacity: 1; transform: none; animation: none !important; }
    .cd-msg.agent .cd-text { opacity: 1; animation: none !important; }
    .cd-dots { display: none; }
    .cd-live { animation: none; }
  }
</style>
