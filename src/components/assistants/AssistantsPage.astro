---
import { SITE, type Locale } from '../../utils/site';
import StackWindow from '../StackWindow.astro';

interface Props {
  content: any;
  locale: Locale;
}

const { content, locale } = Astro.props;
---

<!-- HERO -->
<section class="a-hero container">
  <div class="a-hero-copy" data-reveal>
    <p class="kicker">{content.hero.kicker}</p>
    <h1 class="a-title">{content.hero.titleA} <span>{content.hero.titleB}</span></h1>
    <p class="a-lead">{content.hero.lead}</p>
    <div class="a-chips">
      {content.hero.chips.map((c: string) => <span class="a-chip">{c}</span>)}
    </div>
    <div class="hero-cta">
      <a class="btn btn-primary" href={SITE.whatsapp} target="_blank" rel="noreferrer">{content.hero.ctaPrimary}</a>
      <a class="btn btn-secondary" href="#como">{content.hero.ctaSecondary}</a>
    </div>
  </div>

  <div class="a-hero-visual" data-reveal>
    <StackWindow locale={locale} />
  </div>
</section>

<!-- UN DÍA CON TU AGENTE -->
<section class="container section">
  <h2 data-reveal>{content.day.title}</h2>
  <p class="a-day-lead" data-reveal>{content.day.lead}</p>
  <div class="a-day">
    <div class="a-day-visual" data-reveal>
      <img src="/img/orb-agent.webp" alt="" width="720" height="480" loading="lazy" />
    </div>
    <ol class="a-timeline">
      {content.day.items.map((it: any) => (
        <li class={`a-tl-item ${it.who === 'tú' || it.who === 'you' ? 'is-user' : ''}`} data-reveal>
          <span class="a-tl-time">{it.time}</span>
          <p class="a-tl-text">{it.voice && <span class="a-tl-voice">🎙</span>}{it.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="container section" id="como">
  <h2 data-reveal>{content.how.title}</h2>
  <div class="a-steps">
    {content.how.steps.map((s: any) => (
      <article class="card a-step" data-reveal>
        <span class="a-step-n">{s.n}</span>
        <h3>{s.title}</h3>
        <p>{s.desc}</p>
      </article>
    ))}
  </div>
</section>

<!-- FAQ -->
<section class="container section">
  <h2 data-reveal>{content.faq.title}</h2>
  <div class="a-faq">
    {content.faq.items.map((f: any) => (
      <details class="card a-faq-item" data-reveal>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<!-- CTA: banda spotlight-reveal (firma de esta página) -->
<section class="a-spot" id="a-spot" data-reveal>
  <div class="a-spot-hidden" aria-hidden="true"></div>
  <div class="a-spot-content">
    <h2>{content.cta.title}</h2>
    <p>{content.cta.lead}</p>
    <a class="btn btn-primary" href={SITE.whatsapp} target="_blank" rel="noreferrer">{content.cta.button}</a>
    <p class="a-cta-contact">{SITE.whatsappLabel} · {SITE.email}</p>
  </div>
</section>

<script is:inline>
  // spotlight-reveal: el cursor descubre la capa "viva" del agente
  (() => {
    const band = document.getElementById('a-spot');
    if (!band) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    if (!window.matchMedia('(pointer: fine)').matches) {
      band.classList.add('is-touch'); // en táctil el spotlight orbita solo
      return;
    }
    band.addEventListener('pointermove', (e) => {
      const r = band.getBoundingClientRect();
      band.style.setProperty('--sx', e.clientX - r.left + 'px');
      band.style.setProperty('--sy', e.clientY - r.top + 'px');
    });
  })();
</script>

<style>
  /* local red accent for the mascot/brand pairing */
  .a-hero { --a-red: #e23b2e; }

  /* HERO */
  .a-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.2rem;
    align-items: center;
    padding-top: clamp(2.4rem, 8vw, 5rem);
  }
  .a-title {
    margin-top: 0.8rem;
    font-size: clamp(2.4rem, 6.5vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .a-title span {
    color: var(--accent);
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    letter-spacing: 0;
  }
  .a-lead { margin-top: 1.1rem; max-width: 56ch; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.18rem); }
  .a-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.2rem; }
  .a-chip {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.32rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--panel) 70%, transparent);
  }

  /* HERO VISUAL */
  .a-hero > * { min-width: 0; }
  .a-hero-visual { position: relative; display: grid; place-items: center; padding: 0.5rem 0; }

  /* UN DÍA CON TU AGENTE */
  .a-day-lead { color: var(--muted); max-width: 52ch; margin: 0.4rem 0 0; }
  .a-day { display: grid; grid-template-columns: 1fr; gap: 1.6rem; margin-top: 1.6rem; align-items: start; }
  .a-day-visual img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    border: 1px solid var(--card-border);
    display: block;
  }
  .a-timeline { list-style: none; margin: 0; padding: 0 0 0 1.1rem; position: relative; display: grid; gap: 0.9rem; }
  .a-timeline::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.5rem;
    bottom: 0.5rem;
    width: 1px;
    background: linear-gradient(180deg, var(--accent), transparent 90%);
  }
  .a-tl-item {
    position: relative;
    border: 1px solid var(--card-border);
    border-radius: 12px;
    padding: 0.8rem 1rem;
    background: color-mix(in srgb, var(--panel) 85%, transparent);
  }
  .a-tl-item::before {
    content: '';
    position: absolute;
    left: -1.35rem;
    top: 1.1rem;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    box-shadow: 0 0 8px var(--accent);
  }
  .a-tl-item.is-user { border-left: 2px solid var(--accent); }
  .a-tl-item.is-user::before { background: var(--text); box-shadow: none; }
  .a-tl-time { font-family: var(--font-mono); font-size: 0.72rem; color: var(--accent); letter-spacing: 0.08em; }
  .a-tl-text { margin: 0.25rem 0 0; color: var(--text); font-size: 0.92rem; }
  .a-tl-item.is-user .a-tl-text { color: var(--muted); font-style: italic; }
  .a-tl-voice { margin-right: 0.4rem; }

  /* STEPS */
  .a-steps { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 1.2rem; }
  .a-step { position: relative; }
  .a-step-n { font-family: var(--font-mono); font-size: 1.3rem; color: var(--accent); }
  .a-step h3 { margin: 0.4rem 0; }
  .a-step p { color: var(--muted); margin: 0; }

  /* FAQ */
  .a-faq { display: grid; gap: 0.7rem; margin-top: 1.2rem; interpolate-size: allow-keywords; }
  .a-faq-item summary { cursor: pointer; font-weight: 600; font-family: var(--font-title); list-style: none; }
  .a-faq-item summary::-webkit-details-marker { display: none; }
  .a-faq-item summary::after {
    content: '+';
    float: right;
    color: var(--accent);
    font-family: var(--font-mono);
    display: inline-block;
    transition: transform 260ms ease;
  }
  .a-faq-item[open] summary::after { transform: rotate(45deg); }
  .a-faq-item:hover { border-color: color-mix(in srgb, var(--accent) 40%, var(--card-border)); }
  /* apertura suave donde el navegador lo soporte; degrada a instantáneo */
  .a-faq-item::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size 300ms ease, content-visibility 300ms allow-discrete;
  }
  .a-faq-item[open]::details-content { block-size: auto; }
  .a-faq-item p { color: var(--muted); margin: 0.7rem 0 0; }
  @media (prefers-reduced-motion: reduce) {
    .a-faq-item::details-content { transition: none; }
    .a-faq-item summary::after { transition: none; }
  }

  /* CTA spotlight-reveal: banda oscura; el cursor revela la capa "viva" */
  @property --sx { syntax: '<length-percentage>'; inherits: false; initial-value: 50%; }
  @property --sy { syntax: '<length-percentage>'; inherits: false; initial-value: 50%; }
  .a-spot {
    --sx: 50%;
    --sy: 50%;
    position: relative;
    overflow: hidden;
    margin-top: clamp(2rem, 6vw, 4rem);
    padding: clamp(3rem, 8vw, 5.5rem) 1.5rem;
    background: #070b0a;
    text-align: center;
  }
  .a-spot-hidden {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle 220px at var(--sx) var(--sy), rgba(0, 255, 156, 0.22), transparent 70%),
      repeating-linear-gradient(0deg, transparent 0 23px, rgba(0, 255, 156, 0.14) 23px 24px),
      repeating-linear-gradient(90deg, transparent 0 23px, rgba(0, 255, 156, 0.14) 23px 24px);
    -webkit-mask: radial-gradient(circle 220px at var(--sx) var(--sy), #000 30%, transparent 75%);
    mask: radial-gradient(circle 220px at var(--sx) var(--sy), #000 30%, transparent 75%);
    pointer-events: none;
  }
  .a-spot.is-touch .a-spot-hidden { animation: spotOrbit 9s ease-in-out infinite alternate; }
  @keyframes spotOrbit {
    0% { --sx: 20%; --sy: 30%; }
    100% { --sx: 80%; --sy: 70%; }
  }
  .a-spot-content { position: relative; z-index: 1; }
  .a-spot h2 { color: #f2f7f5; }
  .a-spot p { color: #7d8a9a; }
  .a-spot .btn { margin-top: 0.6rem; }
  .a-cta-contact { margin-top: 0.9rem; font-family: var(--font-mono); font-size: 0.82rem; color: #7d8a9a; }

  @media (min-width: 840px) {
    .a-steps { grid-template-columns: repeat(3, 1fr); }
    .a-day { grid-template-columns: 0.9fr 1.1fr; gap: 2.4rem; }
    .a-day-visual { position: sticky; top: 5.5rem; }
  }
  @media (min-width: 980px) {
    .a-hero { grid-template-columns: 1.02fr 0.98fr; gap: 2.6rem; }
  }

</style>
