---
import { SITE, type Locale } from '../../utils/site';

interface Props {
  content: any;
  locale: Locale;
}

const { content, locale } = Astro.props;

const icons: Record<string, string> = {
  clock:
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.7"/><path d="M12 7.5V12l3.2 2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>',
  chat:
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 7.5A3.5 3.5 0 0 1 8.5 4h7A3.5 3.5 0 0 1 19 7.5v4A3.5 3.5 0 0 1 15.5 15H11l-4.5 4v-4A3.5 3.5 0 0 1 3 11.5v-4Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/></svg>',
  spark:
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 3l1.8 5.4L19 10.2l-5.2 1.8L12 17l-1.8-5L5 10.2l5.2-1.8L12 3Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/></svg>',
  mic:
    '<svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="9" y="3" width="6" height="11" rx="3" stroke="currentColor" stroke-width="1.7"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8.5 21h7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>'
};
---

<!-- HERO -->
<section class="a-hero container">
  <div class="a-hero-copy" data-reveal>
    <p class="kicker">{content.hero.kicker}</p>
    <h1 class="a-title">{content.hero.titleA} <span>{content.hero.titleB}</span></h1>
    <p class="a-lead">{content.hero.lead}</p>
    <div class="a-chips">
      {content.hero.chips.map((c: string) => <span class="a-chip">{c}</span>)}
    </div>
    <div class="hero-cta">
      <a class="btn btn-primary" href={SITE.whatsapp} target="_blank" rel="noreferrer">{content.hero.ctaPrimary}</a>
      <a class="btn btn-secondary" href="#como">{content.hero.ctaSecondary}</a>
    </div>
  </div>

  <div class="a-hero-visual" data-reveal>
    <span class="a-orb a-orb-1" aria-hidden="true"></span>
    <span class="a-orb a-orb-2" aria-hidden="true"></span>
    <div class="a-stage card">
      <div class="a-medallion a-openclaw"><img src="/img/openclaw.jpeg" alt="" loading="lazy" /></div>
      <span class="a-link" aria-hidden="true"></span>
      <div class="a-medallion a-hermes"><img src="/img/hermes.jpeg" alt="" loading="lazy" /></div>
    </div>
    {content.hero.bubbles.map((b: string, i: number) => (
      <div class={`a-bubble a-bubble-${i + 1}`}>{b}</div>
    ))}
  </div>
</section>

<!-- FEATURES -->
<section class="container section">
  <h2 data-reveal>{content.features.title}</h2>
  <div class="a-feature-grid">
    {content.features.items.map((it: any, i: number) => (
      <article class="card a-feature" data-reveal style={`--d:${i * 70}ms`}>
        <span class={`a-ico ${i % 2 === 1 ? 'a-ico-red' : ''}`} set:html={icons[it.icon]} />
        <h3>{it.title}</h3>
        <p>{it.desc}</p>
      </article>
    ))}
  </div>
</section>

<!-- HOW IT WORKS -->
<section class="container section" id="como">
  <h2 data-reveal>{content.how.title}</h2>
  <div class="a-steps">
    {content.how.steps.map((s: any) => (
      <article class="card a-step" data-reveal>
        <span class="a-step-n">{s.n}</span>
        <h3>{s.title}</h3>
        <p>{s.desc}</p>
      </article>
    ))}
  </div>
</section>

<!-- USE CASES -->
<section class="container section">
  <h2 data-reveal>{content.useCases.title}</h2>
  <ul class="a-cases" data-reveal>
    {content.useCases.items.map((u: string) => <li>{u}</li>)}
  </ul>
</section>

<!-- FAQ -->
<section class="container section">
  <h2 data-reveal>{content.faq.title}</h2>
  <div class="a-faq">
    {content.faq.items.map((f: any) => (
      <details class="card a-faq-item" data-reveal>
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<!-- CTA -->
<section class="container section">
  <div class="card a-cta" data-reveal>
    <h2>{content.cta.title}</h2>
    <p>{content.cta.lead}</p>
    <a class="btn btn-primary" href={SITE.whatsapp} target="_blank" rel="noreferrer">{content.cta.button}</a>
    <p class="a-cta-contact">{SITE.whatsappLabel} · {SITE.domain}</p>
  </div>
</section>

<style>
  /* local red accent for the mascot/brand pairing */
  .a-hero { --a-red: #e23b2e; }

  /* HERO */
  .a-hero {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.2rem;
    align-items: center;
    padding-top: clamp(2.4rem, 8vw, 5rem);
  }
  .a-title {
    margin-top: 0.8rem;
    font-size: clamp(2.4rem, 6.5vw, 4.4rem);
    line-height: 1.02;
    letter-spacing: -0.02em;
  }
  .a-title span {
    color: var(--accent);
    text-shadow: 0 0 28px color-mix(in srgb, var(--accent) 45%, transparent);
  }
  .a-lead { margin-top: 1.1rem; max-width: 56ch; color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.18rem); }
  .a-chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-top: 1.2rem; }
  .a-chip {
    border: 1px solid var(--line);
    border-radius: 999px;
    padding: 0.32rem 0.7rem;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--muted);
    background: color-mix(in srgb, var(--panel) 70%, transparent);
  }

  /* HERO VISUAL */
  .a-hero-visual { position: relative; min-height: 340px; display: grid; place-items: center; }
  .a-orb { position: absolute; border-radius: 50%; filter: blur(46px); opacity: 0.6; pointer-events: none; }
  .a-orb-1 { width: 280px; height: 280px; top: -10px; right: 6%; background: radial-gradient(circle, color-mix(in srgb, var(--accent) 60%, transparent), transparent 70%); }
  .a-orb-2 { width: 240px; height: 240px; bottom: -20px; left: 4%; background: radial-gradient(circle, color-mix(in srgb, var(--a-red) 55%, transparent), transparent 70%); }

  .a-stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: clamp(1rem, 4vw, 2.6rem);
    padding: clamp(1.4rem, 4vw, 2.4rem);
    width: min(440px, 100%);
    z-index: 1;
  }
  .a-link {
    width: clamp(40px, 8vw, 80px);
    height: 2px;
    background: linear-gradient(90deg, var(--a-red), var(--accent));
    box-shadow: 0 0 14px color-mix(in srgb, var(--accent) 60%, transparent);
    border-radius: 2px;
  }
  .a-medallion {
    width: clamp(108px, 24vw, 150px);
    height: clamp(108px, 24vw, 150px);
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid rgba(255, 255, 255, 0.7);
    background: radial-gradient(circle at 35% 28%, #ffffff, #eafffb 55%, #ffe7e4);
    box-shadow: 0 0 34px color-mix(in srgb, var(--accent) 32%, transparent), 0 18px 40px rgba(0, 0, 0, 0.3);
  }
  .a-openclaw { transform: rotate(7deg); }
  .a-hermes { transform: rotate(-7deg); }
  .a-medallion img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .a-bubble {
    position: absolute;
    max-width: 220px;
    padding: 0.6rem 0.85rem;
    border-radius: 16px;
    font-size: 0.86rem;
    line-height: 1.25;
    color: var(--text);
    background: color-mix(in srgb, var(--panel) 86%, transparent);
    border: 1px solid var(--card-border);
    backdrop-filter: blur(8px);
    box-shadow: var(--shadow-soft);
    animation: aFloat 6s ease-in-out infinite alternate;
  }
  .a-bubble-1 { top: 2%; right: 0; }
  .a-bubble-2 { bottom: 6%; left: 0; animation-delay: 0.8s; }
  .a-bubble-3 { display: none; }
  .a-bubble-4 { display: none; }

  /* FEATURES */
  .a-feature-grid { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 1.2rem; }
  .a-feature { transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease; transition-delay: var(--d, 0ms); }
  .a-feature:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--accent) 45%, var(--card-border)); box-shadow: 0 16px 34px color-mix(in srgb, var(--accent) 14%, transparent); }
  .a-ico { display: grid; place-items: center; width: 44px; height: 44px; border-radius: 13px; color: var(--accent); background: color-mix(in srgb, var(--accent) 12%, transparent); margin-bottom: 0.7rem; }
  .a-ico-red { color: #ff7a70; background: color-mix(in srgb, #e23b2e 14%, transparent); }
  .a-ico :global(svg) { width: 24px; height: 24px; }
  .a-feature h3 { margin-bottom: 0.4rem; }
  .a-feature p { color: var(--muted); margin: 0; }

  /* STEPS */
  .a-steps { display: grid; grid-template-columns: 1fr; gap: 1rem; margin-top: 1.2rem; }
  .a-step { position: relative; }
  .a-step-n { font-family: var(--font-mono); font-size: 1.3rem; color: var(--accent); }
  .a-step h3 { margin: 0.4rem 0; }
  .a-step p { color: var(--muted); margin: 0; }

  /* USE CASES */
  .a-cases { list-style: none; padding: 0; margin: 1.2rem 0 0; display: grid; grid-template-columns: 1fr; gap: 0.6rem; }
  .a-cases li {
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    border-radius: 10px;
    padding: 0.75rem 0.9rem;
    background: color-mix(in srgb, var(--panel) 80%, transparent);
    color: var(--text);
  }

  /* FAQ */
  .a-faq { display: grid; gap: 0.7rem; margin-top: 1.2rem; }
  .a-faq-item summary { cursor: pointer; font-weight: 600; font-family: var(--font-title); list-style: none; }
  .a-faq-item summary::-webkit-details-marker { display: none; }
  .a-faq-item summary::after { content: '+'; float: right; color: var(--accent); font-family: var(--font-mono); }
  .a-faq-item[open] summary::after { content: '–'; }
  .a-faq-item p { color: var(--muted); margin: 0.7rem 0 0; }

  /* CTA */
  .a-cta { text-align: center; padding: clamp(1.6rem, 5vw, 2.6rem); background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 12%, var(--panel)), var(--panel)); }
  .a-cta p { color: var(--muted); }
  .a-cta .btn { margin-top: 0.6rem; }
  .a-cta-contact { margin-top: 0.9rem; font-family: var(--font-mono); font-size: 0.82rem; }

  @keyframes aFloat { from { transform: translateY(0); } to { transform: translateY(-9px); } }

  @media (min-width: 840px) {
    .a-hero { grid-template-columns: 1.05fr 0.95fr; gap: 2.6rem; }
    .a-feature-grid { grid-template-columns: repeat(2, 1fr); }
    .a-steps { grid-template-columns: repeat(3, 1fr); }
    .a-cases { grid-template-columns: repeat(2, 1fr); }
    .a-bubble-3 { display: block; top: 40%; right: -10px; animation-delay: 1.4s; }
  }

  @media (prefers-reduced-motion: reduce) {
    .a-bubble { animation: none; }
  }
</style>
