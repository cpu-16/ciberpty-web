---
import { SITE, pagePath, type Locale, type PageKey } from '../../utils/site';
import { ICONS } from '../../utils/icons';
import BootTerminal from '../BootTerminal.astro';
import ChatDemo from '../ChatDemo.astro';

interface Props {
  content: any;
  locale: Locale;
}

const { content, locale } = Astro.props;
---

<section class="page-hero container home-hero">
  <div data-reveal>
    <p class="kicker">{content.hero.kicker}</p>
    <h1 class="page-title">{content.hero.titleA} <span>{content.hero.titleB}</span></h1>
    <p class="lead">{content.hero.lead}</p>
    <div class="pill-row">
      {content.hero.chips.map((c: string) => <span class="pill">{c}</span>)}
    </div>
    <div class="hero-cta">
      <a class="btn btn-primary" href={pagePath('assistants', locale)}>{content.hero.ctaPrimary}</a>
      <a class="btn btn-secondary" href={SITE.whatsapp} target="_blank" rel="noreferrer">{content.hero.ctaSecondary}</a>
    </div>
  </div>
  <div class="home-visual" data-reveal>
    <BootTerminal locale={locale} />
  </div>
</section>

<section class="container section demo-split">
  <div class="demo-copy" data-reveal>
    <p class="kicker">{content.demo.kicker}</p>
    <h2 class="demo-title">{content.demo.title} <span>{content.demo.titleSpan}</span></h2>
    <p class="lead">{content.demo.lead}</p>
  </div>
  <ChatDemo header={content.demo.header} status={content.demo.status} messages={content.demo.messages} />
</section>

<section class="container section">
  <h2 data-reveal>{content.highlights.title}</h2>
  <div class="bento">
    {content.highlights.items.map((it: any) => (
      <article class={`card tile bento-item ${it.featured ? 'featured' : ''}`} data-reveal>
        <div class="bento-top">
          <span class="ico" set:html={ICONS[it.icon]} />
          <span class="badge-num">{it.num}</span>
        </div>
        <h3>{it.title}</h3>
        <p>{it.desc}</p>
        <p class="bento-example">{it.example}</p>
      </article>
    ))}
  </div>
</section>

<section class="container section">
  <h2 data-reveal>{content.how.title}</h2>
  <div class="steps how-steps">
    {content.how.steps.map((s: any, i: number) => (
      <div class="card step" data-reveal>
        <span class="num">0{i + 1}</span>
        <h3>{s.title}</h3>
        <p>{s.desc}</p>
      </div>
    ))}
  </div>
</section>

<section class="container section">
  <h2 data-reveal>{content.arms.title}</h2>
  <div class="split arms-split">
    {content.arms.items.map((a: any) => (
      <a class="card arm" href={pagePath(a.key as PageKey, locale)} data-reveal>
        <div class="arm-head">
          <span class={`ico ${a.key === 'cyber' ? 'red' : ''}`} set:html={ICONS[a.icon]} />
          <span class="arm-tag">{a.tag}</span>
        </div>
        <h3>{a.title}</h3>
        <p>{a.desc}</p>
        <span class="more">{a.more} →</span>
      </a>
    ))}
  </div>
</section>

<section class="container section">
  <h2 class="visually-hidden">{content.trust.title}</h2>
  <div class="trust-strip" data-reveal>
    {content.trust.items.map((t: any) => (
      <div class="trust-item">
        <span class="trust-ico" set:html={ICONS[t.icon]} />
        <div>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<section class="container section">
  <div class="card cta-box border-beam" data-reveal>
    <h2>{content.cta.title}</h2>
    <p>{content.cta.lead}</p>
    <a class="btn btn-primary" href={SITE.whatsapp} target="_blank" rel="noreferrer">{content.cta.button}</a>
    <p class="cta-contact">{SITE.whatsappLabel} · {SITE.email}</p>
  </div>
</section>

<style>
  .home-hero { display: grid; grid-template-columns: 1fr; gap: 1.6rem; align-items: center; }
  .home-visual { display: grid; place-items: center; }
  @media (min-width: 840px) {
    .home-hero { grid-template-columns: 1.05fr 0.95fr; gap: 2.6rem; }
  }

  /* Demo del agente */
  .demo-split { display: grid; grid-template-columns: 1fr; gap: 1.8rem; align-items: center; }
  .demo-title { font-size: clamp(1.7rem, 3.4vw, 2.6rem); }
  .demo-title span { color: var(--accent); font-family: var(--font-serif); font-style: italic; font-weight: 400; }
  @media (min-width: 840px) {
    .demo-split { grid-template-columns: 0.9fr 1.1fr; gap: 3rem; }
  }

  /* Bento: los destacados ocupan 2 columnas en diagonal */
  .bento { display: grid; gap: 1rem; grid-template-columns: 1fr; margin-top: 1.2rem; }
  .bento-top { display: flex; align-items: flex-start; justify-content: space-between; }
  .bento-item h3 { margin: 0.2rem 0 0.45rem; }
  .bento-item p { color: var(--muted); margin: 0; }
  .bento-example {
    margin-top: 0.8rem !important;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--accent) !important;
    opacity: 0.85;
  }
  .bento-item.featured { background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 7%, var(--panel)), var(--panel)); }
  @media (min-width: 840px) {
    .bento { grid-template-columns: repeat(3, 1fr); }
    .bento-item.featured { grid-column: span 2; }
  }

  /* Cómo empieza: pasos con conector */
  .how-steps .step { position: relative; }
  @media (min-width: 840px) {
    .how-steps .step:not(:last-child)::before {
      content: '';
      position: absolute;
      top: 50%;
      right: -1rem;
      width: 1rem;
      height: 1px;
      background: linear-gradient(90deg, var(--accent), transparent);
    }
  }

  /* Dos formas: split asimétrico, producto con más peso */
  .arm-head { display: flex; align-items: center; justify-content: space-between; }
  .arm-head .ico { margin-bottom: 0.3rem; }
  @media (min-width: 840px) {
    .arms-split { grid-template-columns: 1.22fr 1fr; }
  }

  /* Franja de confianza */
  .trust-strip {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
    margin-top: 1.2rem;
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border-block: 1px solid var(--line);
  }
  .trust-item { display: flex; gap: 0.75rem; align-items: flex-start; }
  .trust-ico { color: var(--accent); flex: 0 0 auto; display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line)); border-radius: 9px; }
  .trust-ico :global(svg) { width: 19px; height: 19px; }
  .trust-item h3 { font-size: 0.95rem; margin: 0 0 0.2rem; }
  .trust-item p { color: var(--muted); font-size: 0.85rem; margin: 0; }
  @media (min-width: 640px) { .trust-strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 980px) { .trust-strip { grid-template-columns: repeat(4, 1fr); } }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
