---
import { SITE, pagePath, type Locale } from '../../utils/site';
import CinematicHero from './CinematicHero.astro';
import NotaDeVoz from './NotaDeVoz.astro';
import traza from '../../content/traza-bcip.json';

interface Props {
  content: any;
  locale: Locale;
}

const { content, locale } = Astro.props;
const w = content.work;

// Traza de un sismógrafo (envolvente min/max, como la da tiembla.ciberpty.com/api/traza) → `points`
// de una polilínea en un viewBox de 1000×100. asinh comprime los picos para que una réplica
// grande no aplaste todo lo demás.
function trazaPuntos(min: number[], max: number[]): string {
  const n = Math.min(min.length, max.length);
  if (n < 2) return '';
  const mediana = (a: number[]) => [...a].sort((x, y) => x - y)[a.length >> 1];
  const centro = (mediana(min) + mediana(max)) / 2;
  // k = 2.5× el ruido típico: el fondo queda como una línea tranquila y los sismos sobresalen.
  const k = Math.max(1, (mediana(max) - mediana(min)) * 1.25);
  const c = (v: number) => Math.asinh((v - centro) / k);
  let tope = 1;
  for (let i = 0; i < n; i++) tope = Math.max(tope, Math.abs(c(min[i])), Math.abs(c(max[i])));
  const y = (v: number) => (50 - (c(v) / tope) * 46).toFixed(1);
  const pts: string[] = [];
  for (let i = 0; i < n; i++) {
    pts.push(`${((i / n) * 1000).toFixed(1)},${y(min[i])}`, `${(((i + 0.5) / n) * 1000).toFixed(1)},${y(max[i])}`);
  }
  return pts.join(' ');
}
---

<CinematicHero content={content.heroCinematic} locale={locale} />
<NotaDeVoz content={content.voz} />

<section class="trabajo" aria-labelledby="trabajo-title">
  <div class="container">
    <h2 id="trabajo-title" class="trabajo-title">{w.title}</h2>

    <article class="caso caso-tiembla">
      <div class="tiembla-tel">
        <video data-loop muted loop playsinline preload="none" poster="/trabajo/tiembla.jpg" width="540" height="1168" aria-label={w.tiembla.videoAlt}>
          <source src="/trabajo/tiembla.mp4" type="video/mp4" />
        </video>
      </div>
      <div class="caso-texto">
        <p class="tiembla-ticket"><svg viewBox="0 0 30 20" width="21" height="14" aria-hidden="true"><rect width="30" height="20" fill="#fff"/><rect x="15" width="15" height="10" fill="#da121a"/><rect y="10" width="15" height="10" fill="#072357"/><polygon fill="#072357" points="7.50,2.40 8.12,4.15 9.97,4.20 8.50,5.32 9.03,7.10 7.50,6.05 5.97,7.10 6.50,5.32 5.03,4.20 6.88,4.15"/><polygon fill="#da121a" points="22.50,12.40 23.12,14.15 24.97,14.20 23.50,15.32 24.03,17.10 22.50,16.05 20.97,17.10 21.50,15.32 20.03,14.20 21.88,14.15"/></svg> {w.tiembla.ticket}</p>
        <h3>Tiembla</h3>
        <svg class="tiembla-traza" viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
          <polyline points={trazaPuntos(traza.min, traza.max)} />
        </svg>
        <p>{w.tiembla.desc}</p>
        <p class="caso-nota">{w.tiembla.note}</p>
        <a class="caso-link" href="https://tiembla.ciberpty.com" target="_blank" rel="noopener">{w.tiembla.cta} <span aria-hidden="true">↗</span></a>
      </div>
    </article>

    <article class="caso caso-tvn">
      <div class="caso-texto">
        <p class="caso-premio">{w.tvn.award}</p>
        <h3>AgenteTVN</h3>
        <p>{w.tvn.desc}</p>
        <p class="caso-nota">{w.tvn.credit} <a href="https://adwentech.com" target="_blank" rel="noopener">AdwenTech</a>.</p>
      </div>
      <div class="caso-pantalla">
        <video data-loop muted loop playsinline preload="none" poster="/trabajo/agentetvn.jpg" width="960" height="540" aria-label={w.tvn.videoAlt}>
          <source src="/trabajo/agentetvn.mp4" type="video/mp4" />
        </video>
      </div>
    </article>

    <article class="caso caso-n50">
      <div class="n50-cabeza">
        <p class="caso-premio">{w.n50.when}</p>
        <h3>{w.n50.title}</h3>
        <p>{w.n50.desc}</p>
      </div>
      {w.n50.items.map((it: any) => (
        <figure class="n50-item">
          <div class="caso-pantalla">
            <video data-loop muted loop playsinline preload="none" poster={`/trabajo/${it.slug}.jpg`} width="960" height="600" aria-label={it.videoAlt}>
              <source src={`/trabajo/${it.slug}.mp4`} type="video/mp4" />
            </video>
          </div>
          <figcaption>
            <span class="n50-nombre">{it.name}</span>
            <span class="caso-premio">{it.award}</span>
            <span class="n50-desc">{it.desc}</span>
            <a class="caso-link" href={`https://${it.slug}.ciberpty.com`} target="_blank" rel="noopener">{it.cta} <span aria-hidden="true">↗</span></a>
          </figcaption>
        </figure>
      ))}
    </article>
  </div>
</section>

<section class="ciber" aria-labelledby="ciber-title">
  <div class="container ciber-grid">
    <h2 id="ciber-title">{content.cyber.title}</h2>
    <div>
      <p>{content.cyber.desc}</p>
      <a class="caso-link" href={pagePath('cyber', locale)}>{content.cyber.cta}</a>
    </div>
  </div>
</section>

<section class="cierre" aria-labelledby="cierre-title">
  <div class="container">
    <h2 id="cierre-title">{content.close.title}</h2>
    <p>{content.close.desc}</p>
    <div class="cierre-ctas">
      <a class="cierre-btn" href={SITE.whatsapp} target="_blank" rel="noreferrer">{content.close.cta}</a>
      <a class="caso-link" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>
  </div>
</section>

<script>
  // Los videos de «Trabajo» corren solo mientras se ven. Con movimiento reducido no arrancan solos:
  // quedan con su póster y controles para darle play a mano.
  const videos = document.querySelectorAll<HTMLVideoElement>('video[data-loop]');
  if (matchMedia('(prefers-reduced-motion: reduce)').matches || !('IntersectionObserver' in window)) {
    videos.forEach((v) => (v.controls = true));
  } else {
    const obs = new IntersectionObserver(
      (entries) => entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) v.play().catch(() => (v.controls = true));
        else v.pause();
      }),
      { threshold: 0.35 }
    );
    videos.forEach((v) => obs.observe(v));
  }

  const traza = document.querySelector('.tiembla-traza');
  if (traza && 'IntersectionObserver' in window) {
    new IntersectionObserver(([e], o) => {
      if (e.isIntersecting) { o.disconnect(); traza.classList.add('is-drawn'); }
    }, { threshold: 0.6 }).observe(traza.parentElement!); // la traza recortada tiene área 0: se observa su texto
  } else traza?.classList.add('is-drawn');
</script>

<style>
  .trabajo { padding: clamp(4.5rem, 10vw, 8rem) 0 clamp(3rem, 6vw, 5rem); }
  .trabajo-title {
    font-size: clamp(2rem, 4.2vw, 3.4rem);
    letter-spacing: -0.035em;
    max-width: 24ch;
    text-wrap: balance;
    margin: 0 0 clamp(2.5rem, 6vw, 4.5rem);
  }
  .caso { display: grid; gap: clamp(1.8rem, 4vw, 3.5rem); align-items: center; margin-bottom: clamp(4rem, 7vw, 6rem); }
  .caso:last-child { margin-bottom: 0; }
  .caso h3 { font-size: clamp(1.9rem, 3.4vw, 2.8rem); letter-spacing: -0.035em; margin: 0.4rem 0 1rem; text-wrap: balance; }
  .caso-texto p, .n50-cabeza p { color: var(--muted); line-height: 1.65; max-width: 46ch; margin: 0 0 1rem; }
  .caso-texto .caso-nota { font-size: 0.9rem; }
  .caso-nota a { color: var(--text); text-underline-offset: 0.25em; }
  .caso-premio { font-family: var(--font-mono); font-size: 0.82rem; color: var(--accent); margin: 0; }
  .caso-link {
    display: inline-block;
    margin-top: 0.4rem;
    color: var(--text);
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--text) 30%, transparent);
    text-underline-offset: 0.3em;
    transition: text-decoration-color 0.2s ease;
  }
  .caso-link:hover { text-decoration-color: currentColor; }
  .caso video { display: block; width: 100%; height: auto; background: #0d1312; }
  .caso-pantalla { border: 1px solid var(--line); border-radius: 14px; overflow: hidden; }

  /* Tiembla: su propio papel, su traza y su etiqueta amarilla, dentro de la página */
  .caso-tiembla {
    --papel: #f2f4f1; --tinta-t: #1b1f1f; --rojo: #d42a20;
    padding: clamp(1.4rem, 3vw, 2.2rem) clamp(1.4rem, 4vw, 3rem);
    border: 1px solid var(--line);
    border-radius: 20px;
    color: var(--tinta-t);
    background: linear-gradient(90deg, #dde2dd 1px, transparent 1px) 0 0 / 96px 100%, var(--papel);
  }
  .caso-tiembla .caso-texto p { color: #3d4542; }
  .caso-tiembla .caso-link { color: var(--tinta-t); }
  .tiembla-tel {
    order: 1;
    justify-self: center;
    width: min(100%, 7.5rem);
    padding: 5px;
    border-radius: 28px;
    background: var(--tinta-t);
    box-shadow: 0 30px 60px -30px rgb(27 31 31 / 0.55);
  }
  .tiembla-tel video { border-radius: 22px; aspect-ratio: 540 / 1168; object-fit: cover; }
  .tiembla-ticket svg { flex: none; border: 1px solid rgb(27 31 31 / 0.25); border-radius: 2px; }
  .tiembla-ticket {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    padding: 0.3rem 0.7rem;
    border: 2px solid var(--tinta-t);
    border-radius: 8px;
    background: #ffc20e;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.85rem;
  }
  .tiembla-traza { display: block; width: 100%; max-width: 26rem; height: 36px; margin: 0 0 1rem; }
  /* La traza se dibuja una vez, al entrar en pantalla */
  :global(.js-motion) .tiembla-traza { clip-path: inset(0 100% 0 0); }
  :global(.js-motion) .tiembla-traza.is-drawn { clip-path: inset(0 0 0 0); transition: clip-path 1.4s cubic-bezier(0.3, 0.1, 0.2, 1) 0.2s; }
  @media (prefers-reduced-motion: reduce) { :global(.js-motion) .tiembla-traza { clip-path: none; } }
  .tiembla-traza polyline { fill: none; stroke: var(--tinta-t); stroke-width: 1; vector-effect: non-scaling-stroke; }

  .n50-cabeza { margin-bottom: 0.5rem; }
  .n50-item { margin: 0; }
  .n50-item figcaption { display: grid; gap: 0.3rem; margin-top: 1rem; }
  .n50-nombre { font-family: var(--font-display); font-weight: 700; font-size: 1.3rem; letter-spacing: -0.02em; }
  .n50-desc { color: var(--muted); line-height: 1.6; max-width: 44ch; }

  @media (min-width: 52em) {
    .caso-tiembla { grid-template-columns: auto minmax(0, 1fr); gap: clamp(2rem, 5vw, 4rem); }
    .tiembla-tel { order: 0; width: 11rem; }
    .caso-tvn { grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr); }
    .caso-n50 { grid-template-columns: 1fr 1fr; align-items: start; column-gap: clamp(1.5rem, 3vw, 2.5rem); }
    .n50-cabeza { grid-column: 1 / -1; display: grid; grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.4fr); column-gap: clamp(1.8rem, 4vw, 3.5rem); align-items: end; }
    .n50-cabeza p:last-child { margin-bottom: 0.6rem; }
    .n50-cabeza > .caso-premio, .n50-cabeza > h3 { grid-column: 1; }
    .n50-cabeza > p:last-child { grid-column: 2; grid-row: 1 / span 2; }
  }

  /* Ciberseguridad: la segunda línea, en una franja oscura y sobria */
  .ciber { background: var(--hero-bg); color: #eef3f1; padding: clamp(3.5rem, 8vw, 6rem) 0; border-block: 1px solid rgb(255 255 255 / 0.08); }
  .ciber-grid { display: grid; gap: 1.2rem 3rem; align-items: start; }
  .ciber h2 { color: #fff; font-size: clamp(1.7rem, 3.2vw, 2.6rem); letter-spacing: -0.03em; max-width: 18ch; margin: 0; }
  .ciber p { color: rgb(238 243 241 / 0.72); line-height: 1.65; max-width: 48ch; margin: 0 0 1rem; }
  .ciber .caso-link { color: #fff; }
  @media (min-width: 52em) { .ciber-grid { grid-template-columns: 1fr 1fr; } }

  /* Cierre: una persona, dos formas de escribirle */
  .cierre { padding: clamp(4.5rem, 10vw, 8rem) 0; }
  .cierre h2 { font-size: clamp(2rem, 4.2vw, 3.4rem); letter-spacing: -0.035em; margin: 0 0 1rem; text-wrap: balance; }
  .cierre p { color: var(--muted); line-height: 1.65; max-width: 46ch; margin: 0 0 2rem; font-size: 1.05rem; }
  .cierre-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; }
  .cierre-btn {
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font-family: var(--font-display);
    font-weight: 600;
    transition: transform 0.15s ease, filter 0.2s ease;
  }
  .cierre-btn:hover { filter: brightness(1.08); }
  .cierre-btn:active { transform: scale(0.97); }
  .caso-link:focus-visible, .cierre-btn:focus-visible, .caso-nota a:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
</style>
