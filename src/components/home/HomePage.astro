---
import { SITE, pagePath, type Locale, type PageKey } from '../../utils/site';
import { ICONS } from '../../utils/icons';
import CinematicHero from './CinematicHero.astro';
import ChatDemo from '../ChatDemo.astro';
import AdwenLogo from './AdwenLogo.astro';
import traza from '../../content/traza-bcip.json';

interface Props {
  content: any;
  locale: Locale;
}

const { content, locale } = Astro.props;
const tb = content.tiembla;

// Traza de un sismógrafo (envolvente min/max, como la da tiembla.ciberpty.com/api/traza) → `points`
// de una polilínea en un viewBox de 1000×100. asinh comprime los picos para que una réplica
// grande no aplaste todo lo demás.
function trazaPuntos(min: number[], max: number[]): string {
  const n = Math.min(min.length, max.length);
  if (n < 2) return '';
  const mediana = (a: number[]) => [...a].sort((x, y) => x - y)[a.length >> 1];
  const centro = (mediana(min) + mediana(max)) / 2;
  // k = 2.5× el ruido típico: el fondo queda como una línea tranquila y los sismos sobresalen.
  const k = Math.max(1, (mediana(max) - mediana(min)) * 1.25);
  const c = (v: number) => Math.asinh((v - centro) / k);
  let tope = 1;
  for (let i = 0; i < n; i++) tope = Math.max(tope, Math.abs(c(min[i])), Math.abs(c(max[i])));
  const y = (v: number) => (50 - (c(v) / tope) * 46).toFixed(1);
  const pts: string[] = [];
  for (let i = 0; i < n; i++) {
    pts.push(`${((i / n) * 1000).toFixed(1)},${y(min[i])}`, `${(((i + 0.5) / n) * 1000).toFixed(1)},${y(max[i])}`);
  }
  return pts.join(' ');
}
---

<CinematicHero content={content.heroCinematic} locale={locale} />

<section class="container section demo-split">
  <div class="demo-copy" data-reveal>
    <p class="kicker">{content.demo.kicker}</p>
    <h2 class="demo-title">{content.demo.title} <span>{content.demo.titleSpan}</span></h2>
    <p class="lead">{content.demo.lead}</p>
  </div>
  <ChatDemo header={content.demo.header} status={content.demo.status} messages={content.demo.messages} />
</section>

<section class="container section">
  <h2 data-reveal>{content.highlights.title}</h2>
  <div class="bento">
    {content.highlights.items.map((it: any) => (
      <article class={`card tile bento-item ${it.featured ? 'featured' : ''}`} data-reveal>
        <div class="bento-top">
          <span class="ico" set:html={ICONS[it.icon]} />
          <span class="badge-num">{it.num}</span>
        </div>
        <h3>{it.title}</h3>
        <p>{it.desc}</p>
        <p class="bento-example">{it.example}</p>
      </article>
    ))}
  </div>
</section>

<section class="container section">
  <h2 data-reveal>{content.how.title}</h2>
  <div class="steps how-steps">
    {content.how.steps.map((s: any, i: number) => (
      <div class="card step" data-reveal>
        <span class="num">0{i + 1}</span>
        <h3>{s.title}</h3>
        <p>{s.desc}</p>
      </div>
    ))}
  </div>
</section>

<section class="container section">
  <h2 data-reveal>{content.arms.title}</h2>
  <div class="split arms-split">
    {content.arms.items.map((a: any) => (
      <a class="card arm" href={pagePath(a.key as PageKey, locale)} data-reveal>
        <div class="arm-head">
          <span class={`ico ${a.key === 'cyber' ? 'red' : ''}`} set:html={ICONS[a.icon]} />
          <span class="arm-tag">{a.tag}</span>
        </div>
        <h3>{a.title}</h3>
        <p>{a.desc}</p>
        <span class="more">{a.more} →</span>
      </a>
    ))}
  </div>
</section>

<section class="container section">
  <h2 class="visually-hidden">{content.trust.title}</h2>
  <div class="trust-strip" data-reveal>
    {content.trust.items.map((t: any) => (
      <div class="trust-item">
        <span class="trust-ico" set:html={ICONS[t.icon]} />
        <div>
          <h3>{t.title}</h3>
          <p>{t.desc}</p>
        </div>
      </div>
    ))}
  </div>
</section>

<section class="container section">
  <article class="sismo" aria-labelledby="tiembla-title">
    <div class="sismo-head">
      <div>
        <p class="kicker">{tb.kicker}</p>
        <h2 id="tiembla-title">Tiembla</h2>
        <p class="sismo-frase">{tb.frase}</p>
      </div>
      <p class="sismo-desc">{tb.desc}</p>
    </div>
    <figure class="sismo-traza" data-sismo>
      <div class="sismo-lienzo">
        <svg viewBox="0 0 1000 100" preserveAspectRatio="none" aria-hidden="true">
          <polyline points={trazaPuntos(traza.min, traza.max)} />
        </svg>
        <span class="sismo-pluma" aria-hidden="true"></span>
      </div>
      <figcaption>{tb.traza}</figcaption>
    </figure>
    <div class="sismo-pie">
      <a class="sismo-btn" href="https://tiembla.ciberpty.com" target="_blank" rel="noopener">{tb.cta}</a>
      <span class="sismo-url">
        <svg viewBox="0 0 30 20" width="21" height="14" aria-hidden="true"><rect width="30" height="20" fill="#fff"/><rect x="15" width="15" height="10" fill="#da121a"/><rect y="10" width="15" height="10" fill="#072357"/><polygon fill="#072357" points="7.50,2.40 8.12,4.15 9.97,4.20 8.50,5.32 9.03,7.10 7.50,6.05 5.97,7.10 6.50,5.32 5.03,4.20 6.88,4.15"/><polygon fill="#da121a" points="22.50,12.40 23.12,14.15 24.97,14.20 23.50,15.32 24.03,17.10 22.50,16.05 20.97,17.10 21.50,15.32 20.03,14.20 21.88,14.15"/></svg>
        tiembla.ciberpty.com
      </span>
    </div>
  </article>
</section>

<script>
  // Una sola animación: la traza se dibuja una vez, al entrar en pantalla.
  const fig = document.querySelector('[data-sismo]');
  if (fig) {
    if (!('IntersectionObserver' in window)) fig.classList.add('is-drawn');
    else new IntersectionObserver(([e], o) => {
      if (e.isIntersecting) { o.disconnect(); fig.classList.add('is-drawn'); }
    }, { threshold: 0.4 }).observe(fig);
  }
</script>

<section class="container section">
  <a class="card collab" href="https://adwentech.com" target="_blank" rel="noopener" data-reveal>
    <div class="collab-copy">
      <p class="kicker">{content.collab.kicker}</p>
      <h2>{content.collab.title}</h2>
      <p>{content.collab.desc}</p>
      <span class="more">{content.collab.more} →</span>
    </div>
    <div class="collab-logo"><AdwenLogo /></div>
  </a>
</section>

<section class="container section">
  <div class="card cta-box border-beam" data-reveal>
    <h2>{content.cta.title}</h2>
    <p>{content.cta.lead}</p>
    <a class="btn btn-primary" href={SITE.whatsapp} target="_blank" rel="noreferrer">{content.cta.button}</a>
    <p class="cta-contact">{SITE.whatsappLabel} · {SITE.email}</p>
  </div>
</section>

<style>
  /* Demo del agente */
  .demo-split { display: grid; grid-template-columns: 1fr; gap: 1.8rem; align-items: center; }
  .demo-title { font-size: clamp(1.7rem, 3.4vw, 2.6rem); }
  .demo-title span { color: var(--accent); font-family: var(--font-serif); font-style: italic; font-weight: 400; }
  @media (min-width: 840px) {
    .demo-split { grid-template-columns: 0.9fr 1.1fr; gap: 3rem; }
  }

  /* Bento: los destacados ocupan 2 columnas en diagonal */
  .bento { display: grid; gap: 1rem; grid-template-columns: 1fr; margin-top: 1.2rem; }
  .bento-top { display: flex; align-items: flex-start; justify-content: space-between; }
  .bento-item h3 { margin: 0.2rem 0 0.45rem; }
  .bento-item p { color: var(--muted); margin: 0; }
  .bento-example {
    margin-top: 0.8rem !important;
    font-family: var(--font-mono);
    font-size: 0.76rem;
    color: var(--accent) !important;
    opacity: 0.85;
  }
  .bento-item.featured { background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 7%, var(--panel)), var(--panel)); }
  @media (min-width: 840px) {
    .bento { grid-template-columns: repeat(3, 1fr); }
    .bento-item.featured { grid-column: span 2; }
  }

  /* Cómo empieza: pasos con conector */
  .how-steps .step { position: relative; }
  @media (min-width: 840px) {
    .how-steps .step:not(:last-child)::before {
      content: '';
      position: absolute;
      top: 50%;
      right: -1rem;
      width: 1rem;
      height: 1px;
      background: linear-gradient(90deg, var(--accent), transparent);
    }
  }

  /* Dos formas: split asimétrico, producto con más peso */
  .arm-head { display: flex; align-items: center; justify-content: space-between; }
  .arm-head .ico { margin-bottom: 0.3rem; }
  @media (min-width: 840px) {
    .arms-split { grid-template-columns: 1.22fr 1fr; }
  }

  /* Franja de confianza */
  .trust-strip {
    display: grid;
    gap: 1.1rem;
    grid-template-columns: 1fr;
    margin-top: 1.2rem;
    padding: clamp(1.2rem, 3vw, 1.8rem);
    border-block: 1px solid var(--line);
  }
  .trust-item { display: flex; gap: 0.75rem; align-items: flex-start; }
  .trust-ico { color: var(--accent); flex: 0 0 auto; display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid color-mix(in srgb, var(--accent) 35%, var(--line)); border-radius: 9px; }
  .trust-ico :global(svg) { width: 19px; height: 19px; }
  .trust-item h3 { font-size: 0.95rem; margin: 0 0 0.2rem; }
  .trust-item p { color: var(--muted); font-size: 0.85rem; margin: 0; }
  @media (min-width: 640px) { .trust-strip { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 980px) { .trust-strip { grid-template-columns: repeat(4, 1fr); } }

  /* Tiembla: tira de papel de sismógrafo, igual en tema claro y oscuro */
  .sismo {
    --papel: #f2f4f1; --tinta: #1b1f1f; --reja: #dde2dd; --rojo: #d42a20; --nota: #5b6461;
    --pad: clamp(1.4rem, 4vw, 2.8rem);
    display: grid;
    gap: clamp(1.4rem, 3vw, 2.2rem);
    padding: var(--pad);
    border: 1px solid var(--line);
    border-radius: 14px;
    color: var(--tinta);
    background: linear-gradient(90deg, var(--reja) 1px, transparent 1px) 0 0 / 96px 100%, var(--papel);
  }
  .sismo .kicker { color: var(--rojo); }
  .sismo-head { display: grid; gap: 1.1rem; }
  .sismo h2 { font-size: clamp(3rem, 8vw, 6rem); font-weight: 800; letter-spacing: -0.045em; line-height: 0.9; margin: 0.35rem 0 0.8rem; }
  .sismo-frase { margin: 0; max-width: 28ch; font-family: var(--font-serif); font-style: italic; font-size: clamp(1.3rem, 2.4vw, 1.75rem); line-height: 1.25; }
  .sismo-desc { margin: 0; max-width: 54ch; color: #3d4542; font-size: 0.92rem; line-height: 1.7; }
  @media (min-width: 840px) { .sismo-head { grid-template-columns: 1.1fr 1fr; gap: 3rem; align-items: end; } }

  .sismo-traza { margin: 0; }
  .sismo-lienzo { position: relative; }
  .sismo-lienzo svg { display: block; width: 100%; height: clamp(90px, 13vw, 160px); overflow: visible; }
  .sismo-lienzo polyline { fill: none; stroke: var(--tinta); stroke-width: 1; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .sismo-pluma { position: absolute; inset: 0; pointer-events: none; }
  .sismo-pluma::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--rojo);
    transform: translate(50%, -50%);
  }
  .sismo-traza figcaption { margin-top: 0.7rem; color: var(--nota); font-family: var(--font-mono); font-size: 0.72rem; }
  /* La transición vive solo en .is-drawn: si estuviera en el estado base, al cargar la página el punto
     arrancaría una transición hacia -100 % y Chrome acortaría la de vuelta (se desfasa de la traza). */
  :global(.js-motion) .sismo-traza svg { clip-path: inset(0 0 0 0); }
  .sismo-traza.is-drawn svg { transition: clip-path 2.4s cubic-bezier(0.3, 0.1, 0.2, 1); }
  .sismo-traza.is-drawn .sismo-pluma { transition: transform 2.4s cubic-bezier(0.3, 0.1, 0.2, 1); }
  :global(.js-motion) .sismo-traza:not(.is-drawn) svg { clip-path: inset(0 100% 0 0); }
  :global(.js-motion) .sismo-traza:not(.is-drawn) .sismo-pluma { transform: translateX(-100%); }
  .sismo-traza.is-drawn .sismo-pluma::after { animation: latido 1.8s ease-out 2.4s infinite; }
  @keyframes latido {
    0% { box-shadow: 0 0 0 0 rgb(212 42 32 / 0.45); }
    70%, 100% { box-shadow: 0 0 0 12px rgb(212 42 32 / 0); }
  }

  .sismo-pie { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; }
  .sismo-btn {
    display: inline-flex;
    align-items: center;
    padding: 0.8rem 1.3rem;
    border-radius: 999px;
    background: var(--tinta);
    color: var(--papel);
    font-family: var(--font-display);
    font-weight: 600;
    text-decoration: none;
    transition: background-color 0.2s ease, transform 0.15s ease;
  }
  .sismo-btn:hover { background: var(--rojo); }
  .sismo-btn:active { transform: scale(0.97); }
  .sismo-btn:focus-visible { outline: 2px solid var(--rojo); outline-offset: 3px; }
  .sismo-url { display: inline-flex; align-items: center; gap: 0.55rem; color: var(--nota); font-family: var(--font-mono); font-size: 0.8rem; }
  .sismo-url svg { border: 1px solid var(--reja); }
  @media (prefers-reduced-motion: reduce) {
    .sismo-traza.is-drawn svg, .sismo-traza.is-drawn .sismo-pluma { transition: none; }
    .sismo-traza.is-drawn .sismo-pluma::after { animation: none; }
  }

  /* Colaboración con AdwenTech */
  .collab { display: grid; gap: 1.6rem; align-items: center; color: inherit; text-decoration: none; }
  .collab h2 { font-size: clamp(1.5rem, 3vw, 2.2rem); margin: 0.2rem 0 0.6rem; }
  .collab p:not(.kicker) { color: var(--muted); margin: 0 0 0.9rem; max-width: 56ch; }
  .collab-logo { color: var(--text); justify-self: center; width: min(100%, 340px); }
  .collab-logo :global(.adwen-logo) { display: block; width: 100%; height: auto; }
  :global([data-theme='light']) .collab-logo { color: #041e3a; }
  @media (min-width: 840px) { .collab { grid-template-columns: 1.3fr 1fr; gap: 3rem; } }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>
