---
import { SITE, pagePath, type Locale } from '../../utils/site';

interface Props {
  content: any; // homeEs.hero | homeEn.hero
  locale: Locale;
}

const { content: c, locale } = Astro.props;
// Alturas de la onda de la nota de voz (fijas: que no cambie entre builds).
const onda = [5, 9, 14, 8, 18, 22, 12, 7, 16, 24, 19, 10, 6, 13, 21, 15, 9, 17, 23, 11, 7, 14, 20, 12, 8, 5];
---

<section class="hh">
  <div class="hh-grid">
    <div class="hh-copy">
      <h1>{c.title}</h1>
      <p class="hh-lead">{c.lead}</p>
      <div class="hh-ctas">
        <a class="hh-btn" href={SITE.whatsapp} target="_blank" rel="noreferrer">{c.ctaPrimary}</a>
        <a class="hh-link" href={pagePath('assistants', locale)}>{c.ctaSecondary}</a>
      </div>
    </div>

    <figure class="hh-chat" aria-label={c.chat.label}>
      <header class="hh-chat-top">
        <span class="hh-avatar" aria-hidden="true">&gt;<i>_</i></span>
        <span>
          <strong>{c.chat.name}</strong>
          <small>{c.chat.status}</small>
        </span>
      </header>

      <div class="hh-msg hh-voz">
        <span class="hh-play" aria-hidden="true"></span>
        <span class="hh-onda" aria-hidden="true">
          <span class="hh-barras">{onda.map((h) => <i style={`height:${h}px`} />)}</span>
          <span class="hh-barras hh-oida">{onda.map((h) => <i style={`height:${h}px`} />)}</span>
        </span>
        <span class="hh-meta">{c.chat.voiceLength}</span>
        <span class="visually-hidden">{c.chat.voiceAlt}</span>
      </div>

      <div class="hh-turno">
      <div class="hh-escribiendo" aria-hidden="true"><i></i><i></i><i></i></div>
      <div class="hh-msg hh-agente">
        <p>{c.chat.reply}</p>
        <ul>
          {c.chat.done.map((d: string) => (
            <li>
              <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" /></svg>
              <span>{d}</span>
            </li>
          ))}
        </ul>
        <span class="hh-meta">{c.chat.time}</span>
      </div>
      </div>
    </figure>
  </div>
</section>

<style>
  /* El hero es oscuro en ambos temas. Verde = acción (el botón, lo que el agente dejó hecho). */
  .hh {
    --verde: #00ff9c;
    --tinta: #eef3f1;
    --gris: #8d9a96;
    --linea: rgb(255 255 255 / 0.09);
    position: relative;
    background: var(--hero-bg);
    color: var(--tinta);
    padding: clamp(7rem, 14vh, 9rem) 0 clamp(3.5rem, 8vh, 5.5rem);
  }
  .hh-grid {
    width: var(--container);
    margin-inline: auto;
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }
  @media (min-width: 60em) {
    .hh-grid { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
  }

  .hh h1 {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 4.7vw, 4rem);
    line-height: 1.04;
    letter-spacing: -0.04em;
    max-width: 15ch;
    color: #fff;
    margin: 0 0 1.4rem;
    text-wrap: balance;
  }
  .hh-lead {
    font-size: clamp(1.02rem, 1.4vw, 1.18rem);
    line-height: 1.6;
    color: rgb(238 243 241 / 0.74);
    max-width: 40ch;
    margin: 0 0 2rem;
  }
  .hh-ctas { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.6rem; }
  .hh-btn {
    padding: 0.9rem 1.5rem;
    border-radius: 999px;
    background: var(--verde);
    color: #04140d;
    font-family: var(--font-display);
    font-weight: 600;
    transition: transform 0.15s ease, filter 0.2s ease;
  }
  .hh-btn:hover { filter: brightness(1.08); }
  .hh-btn:active { transform: scale(0.97); }
  .hh-link { color: var(--tinta); text-decoration: underline; text-decoration-color: rgb(238 243 241 / 0.35); text-underline-offset: 0.3em; }
  .hh-link:hover { text-decoration-color: currentColor; }
  .hh-btn:focus-visible, .hh-link:focus-visible { outline: 2px solid var(--verde); outline-offset: 4px; }

  /* El chat: una conversación de Telegram reducida a lo esencial */
  .hh-chat {
    margin: 0;
    justify-self: center;
    width: min(100%, 25rem);
    display: grid;
    gap: 0.7rem;
    font-size: 0.95rem;
  }
  .hh-chat-top { display: flex; align-items: center; gap: 0.7rem; padding: 0.2rem 0.3rem 0.8rem; border-bottom: 1px solid var(--linea); }
  .hh-chat-top strong { display: block; font-weight: 600; }
  .hh-chat-top small { color: var(--verde); font-size: 0.78rem; }
  .hh-avatar i { font-style: normal; }
  .hh-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    background: #15201d;
    color: var(--verde);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .hh-msg { position: relative; border-radius: 18px; padding: 0.7rem 0.85rem 1.3rem; }
  .hh-meta { position: absolute; right: 0.8rem; bottom: 0.4rem; color: var(--gris); font-family: var(--font-mono); font-size: 0.72rem; }

  .hh-voz {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 82%;
    background: #1d3a2f;
    border-bottom-right-radius: 6px;
  }
  .hh-play { flex: none; width: 2rem; height: 2rem; border-radius: 50%; background: var(--verde); position: relative; }
  .hh-play::after { content: ''; position: absolute; left: 52%; top: 50%; transform: translate(-50%, -50%); border-left: 9px solid #04140d; border-block: 6px solid transparent; }
  .hh-onda { position: relative; flex: 1; height: 24px; }
  .hh-barras { position: absolute; inset: 0; display: flex; align-items: center; justify-content: space-between; }
  .hh-barras i { width: 2.5px; border-radius: 2px; background: rgb(238 243 241 / 0.35); }
  .hh-oida i { background: var(--verde); }

  /* El «escribiendo» y la respuesta comparten celda: no hay salto de alto cuando uno reemplaza al otro. */
  .hh-turno { display: grid; }
  .hh-turno > * { grid-area: 1 / 1; }
  .hh-escribiendo { display: none; align-self: start; gap: 4px; padding: 0.8rem 0.9rem; width: max-content; border-radius: 18px; background: #18201e; }
  .hh-escribiendo i { width: 6px; height: 6px; border-radius: 50%; background: var(--gris); }

  .hh-agente { background: #18201e; border-bottom-left-radius: 6px; width: 92%; }
  .hh-agente p { margin: 0 0 0.6rem; line-height: 1.45; }
  .hh-agente ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.45rem; }
  .hh-agente li { display: grid; grid-template-columns: 16px 1fr; gap: 0.55rem; align-items: start; line-height: 1.4; }
  .hh-agente svg { width: 16px; height: 16px; margin-top: 1px; fill: none; stroke: var(--verde); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }

  /* El único momento orquestado de la portada (≈3.6 s): la nota se escucha, el agente escribe y responde. */
  :global(.js-motion) .hh-voz { animation: hh-entra 0.4s ease-out 0.4s both; }
  :global(.js-motion) .hh-oida { animation: hh-oir 1.6s linear 0.8s both; }
  :global(.js-motion) .hh-escribiendo { display: flex; animation: hh-pensar 0.9s step-end 2.4s both; }
  :global(.js-motion) .hh-escribiendo i { animation: hh-punto 0.9s ease-in-out infinite; }
  :global(.js-motion) .hh-escribiendo i:nth-child(2) { animation-delay: 0.15s; }
  :global(.js-motion) .hh-escribiendo i:nth-child(3) { animation-delay: 0.3s; }
  :global(.js-motion) .hh-agente { animation: hh-entra 0.4s ease-out 3.3s both; }
  :global(.js-motion) .hh-agente li { animation: hh-entra 0.3s ease-out both; }
  :global(.js-motion) .hh-agente path { stroke-dasharray: 16; animation: hh-trazo 0.35s ease-out both; }
  :global(.js-motion) .hh-agente li:nth-child(1), :global(.js-motion) .hh-agente li:nth-child(1) path { animation-delay: 3.6s; }
  :global(.js-motion) .hh-agente li:nth-child(2), :global(.js-motion) .hh-agente li:nth-child(2) path { animation-delay: 3.78s; }
  :global(.js-motion) .hh-agente li:nth-child(3), :global(.js-motion) .hh-agente li:nth-child(3) path { animation-delay: 3.96s; }
  /* El cursor del >_ parpadea como en una terminal: la marca, viva. */
  :global(.js-motion) .hh-avatar i { animation: hh-caret 1.1s steps(1) infinite; }
  @keyframes hh-caret { 50% { opacity: 0; } }
  @keyframes hh-entra { from { opacity: 0; transform: translateY(8px); } }
  @keyframes hh-oir { from { clip-path: inset(0 100% 0 0); } to { clip-path: inset(0 0 0 0); } }
  @keyframes hh-pensar { 0% { opacity: 0; } 1% { opacity: 1; } 100% { opacity: 0; } }
  @keyframes hh-punto { 50% { opacity: 0.3; transform: translateY(-2px); } }
  @keyframes hh-trazo { from { stroke-dashoffset: 16; } }
  @media (prefers-reduced-motion: reduce) {
    :global(.js-motion) .hh *, :global(.js-motion) .hh-escribiendo { animation: none !important; }
    :global(.js-motion) .hh-escribiendo { display: none; }
  }
</style>
