---
import { type Locale } from '../utils/site';

interface Props {
  content: any;
  locale: Locale;
}

const { content, locale } = Astro.props;
const [featured, ...rest] = content.posts;
---

<section class="page-hero container">
  <div data-reveal>
    <p class="kicker">{content.kicker}</p>
    <h1 class="page-title">{content.heading}</h1>
    <p class="lead">{content.lead}</p>
  </div>
</section>

<section class="container section">
  <a class="card b-featured" href={featured.href} data-reveal>
    <div class="b-featured-media">
      <img src={featured.cover} alt="" width="1200" height="675" loading="eager" />
    </div>
    <div class="b-featured-body">
      <span class="meta">{featured.cat} · {featured.date} · {featured.read}</span>
      <h2>{featured.title}</h2>
      <p>{featured.excerpt}</p>
      <span class="more">{content.readMore} →</span>
    </div>
  </a>

  <div class="b-grid">
    {rest.map((p: any) => (
      <a class="card b-card" href={p.href} data-reveal>
        <div class="b-card-media">
          <img src={p.cover} alt="" width="600" height="338" loading="lazy" />
        </div>
        <div class="b-card-body">
          <span class="meta">{p.cat} · {p.date} · {p.read}</span>
          <h3>{p.title}</h3>
          <p>{p.excerpt}</p>
          <span class="more">{content.readMore} →</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  /* Destacado editorial */
  .b-featured {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    padding: 0;
    text-decoration: none;
  }
  .b-featured-media { overflow: hidden; }
  .b-featured-media img,
  .b-card-media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms var(--ease-out-expo, ease);
  }
  .b-featured:hover .b-featured-media img,
  .b-card:hover .b-card-media img { transform: scale(1.04); }
  .b-featured-body { padding: clamp(1.2rem, 3vw, 2rem); }
  .b-featured-body h2 { margin: 0.5rem 0 0.6rem; font-size: clamp(1.5rem, 3vw, 2.2rem); line-height: 1.15; }
  .b-featured-body p { color: var(--muted); margin: 0 0 0.8rem; max-width: 58ch; }

  /* Grid del resto */
  .b-grid { display: grid; gap: 1rem; grid-template-columns: 1fr; margin-top: 1rem; }
  .b-card { display: flex; flex-direction: column; overflow: hidden; padding: 0; text-decoration: none; }
  .b-card-media { aspect-ratio: 16 / 9; overflow: hidden; }
  .b-card-body { padding: 1.1rem 1.2rem 1.3rem; display: flex; flex-direction: column; gap: 0.45rem; }
  .b-card-body h3 { margin: 0; line-height: 1.25; }
  .b-card-body p { color: var(--muted); margin: 0; font-size: 0.9rem; }
  .b-card .more, .b-featured .more { margin-top: auto; }

  .meta { font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; }

  @media (min-width: 840px) {
    .b-featured { grid-template-columns: 1.15fr 1fr; align-items: center; }
    .b-featured-media { height: 100%; }
    .b-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
